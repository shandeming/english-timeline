{
  "manifest_version": 3,
  "name": "English Timeline",
  "version": "1.0.0",
  "description": "Bookmark moments on YouTube's timeline with a keyboard shortcut, then click to replay with an adjustable lead-in.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["core.js", "content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }]
}
